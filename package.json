{
	"name": "slash",
	"description": "A fast, light-weight anonymous chat application.",
	"author": "ezsnova",
	"version": "1.0",
	"private": true,
	"packageManager": "bun@1.2.20",
	"scripts": {
		"dev:server": "node ./server/server.js",
		"dev:socket-worker": "bun --cwd ./socket-worker run dev",
		"deploy:socket-worker": "bun --cwd ./socket-worker run deploy",
		"dev-set-admin": "node ./scripts/set-admin.mjs --db dev",
		"set-admin": "node ./scripts/set-admin.mjs --db prod",
		"dev": "vite dev",
		"build": "node ./node_modules/vite/bin/vite.js build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@flydotio/dockerfile": "^0.5.8",
		"@sveltejs/adapter-vercel": "6",
		"@sveltejs/kit": "^2.57.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/bcrypt": "^5.0.2",
		"@types/express": "^4.17.21",
		"prettier": "^3.8.2",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.3",
		"svelte-check": "^4.4.6",
		"tslib": "^2.4.1",
		"typescript": "^5.9.3",
		"vite": "^8.0.8"
	},
	"type": "module",
	"dependencies": {
		"@magidoc/plugin-svelte-marked": "^6.3.0",
		"@speed-highlight/core": "^1.2.15",
		"@vercel/blob": "^2.3.3",
		"bcrypt": "^5.1.1",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"mongodb": "^6.3.0",
		"morgan": "^1.10.0",
		"socket.io": "^4.7.2",
		"socket.io-client": "^4.7.2"
	}
}
